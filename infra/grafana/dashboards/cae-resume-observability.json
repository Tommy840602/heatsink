        "defaults": {
          "mappings": [
            { "options": { "0": { "color": "red", "text": "Degraded" }, "1": { "color": "green", "text": "Healthy" } }, "type": "value" }
          ],
          "thresholds": { "mode": "absolute", "steps": [{ "color": "red", "value": null }, { "color": "green", "value": 1 }] }
