THERMOFORM_ENV=development
THERMOFORM_POSTGRES_DB=thermoform
THERMOFORM_POSTGRES_USER=thermoform
# Replace for every non-local environment; never commit a real password.
THERMOFORM_POSTGRES_PASSWORD=thermoform-local-only
THERMOFORM_POSTGRES_PORT=5433
THERMOFORM_CORS_ORIGINS=http://localhost:8080,http://localhost:3000
# Optional internal/open mirror for air-gapped or restricted build networks.
THERMOFORM_PYPI_INDEX_URL=https://pypi.org/simple
THERMOFORM_NPM_REGISTRY=https://registry.npmjs.org
THERMOFORM_DEBIAN_MIRROR_URL=http://deb.debian.org/debian
THERMOFORM_DEBIAN_SECURITY_MIRROR_URL=http://deb.debian.org/debian-security
THERMOFORM_THANOS_RETENTION_RAW=0d
THERMOFORM_THANOS_RETENTION_5M=0d
THERMOFORM_THANOS_RETENTION_1H=0d
