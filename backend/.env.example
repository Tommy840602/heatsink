THERMOFORM_ENV=development
THERMOFORM_CORS_ORIGINS=http://localhost:3000
THERMOFORM_REDIS_URL=redis://localhost:6379/0
THERMOFORM_ARTIFACT_DIR=data
THERMOFORM_HEARTBEAT_STALE_SECONDS=120
THERMOFORM_WATCHDOG_STALE_SECONDS=180
THERMOFORM_OBSERVABILITY_ATTEMPT_LIMIT=1000
# Source an OpenCFD OpenFOAM v2312 shell before starting the CAE worker.
# FOAM_TUTORIALS=/opt/openfoam2312/tutorials
# THERMOFORM_OPENFOAM_BENCHMARK_CASE=/absolute/path/to/multiRegionHeater
